+#define RDRAM_OFFSET(offset, reg) \
+    ((uint32_t)((reg) + (offset)) & 0x1FFFFFFFu)
+
 #define MEM_W(offset, reg) \
-    (*(int32_t*)(rdram + ((((reg) + (offset))) - 0xFFFFFFFF80000000)))
+    (*(int32_t*)(rdram + RDRAM_OFFSET((offset), (reg))))
 
