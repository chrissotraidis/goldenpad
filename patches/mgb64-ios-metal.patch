+/* Recycle evicted RGBA upload textures only after the frame slot that last used
+ * them has completed. Simulator texture creation is a synchronous driver XPC;
+ * keeping a bounded pool removes that churn while the existing three-slot
+ * semaphore preserves the same no-write-while-in-flight guarantee as s_vbuf. */
+#define MTL_UPLOAD_TEXTURE_POOL_CAP 1024
+static NSMutableDictionary<NSNumber *, NSMutableArray<id<MTLTexture>> *> *s_reusable_textures = nil;
+static NSMutableArray<id<MTLTexture>> *s_retired_textures[MTL_VBUF_SLOTS];
+static NSUInteger s_reusable_texture_count = 0;
+
+static NSNumber *mtl_upload_texture_key(NSUInteger width, NSUInteger height) {
+    return @(((uint64_t)width << 32) | (uint64_t)height);
+}
+
+static void mtl_recycle_completed_texture_slot(int slot) {
+    if (slot < 0 || slot >= MTL_VBUF_SLOTS || s_reusable_textures == nil) return;
+    NSMutableArray<id<MTLTexture>> *retired = s_retired_textures[slot];
+    for (id<MTLTexture> tex in retired) {
+        if (s_reusable_texture_count >= MTL_UPLOAD_TEXTURE_POOL_CAP) break;
+        NSNumber *key = mtl_upload_texture_key(tex.width, tex.height);
+        NSMutableArray<id<MTLTexture>> *bucket = s_reusable_textures[key];
+        if (bucket == nil) {
+            bucket = [NSMutableArray array];
+            s_reusable_textures[key] = bucket;
+        }
+        [bucket addObject:tex];
+        s_reusable_texture_count++;
+    }
+    [retired removeAllObjects];
+}
+
+static id<MTLTexture> mtl_take_reusable_texture(NSUInteger width, NSUInteger height) {
+    if (s_reusable_textures == nil) return nil;
+    NSNumber *key = mtl_upload_texture_key(width, height);
+    NSMutableArray<id<MTLTexture>> *bucket = s_reusable_textures[key];
+    id<MTLTexture> tex = bucket.lastObject;
+    if (tex != nil) {
+        [bucket removeLastObject];
+        s_reusable_texture_count--;
+        if (bucket.count == 0) [s_reusable_textures removeObjectForKey:key];
+    }
+    return tex;
+}
